# BUSY Bar environment configuration example
# Copy this file to .env and fill in your device credentials.

# Default device to target from config/devices.toml (or config/devices.example.toml)
BUSYBAR_DEVICE=office

# LAN Access Token for BUSY Bar (generated in device local web UI at http://10.0.4.20 or device Wi-Fi IP)
# Note: Wi-Fi API access is disabled by default in local web UI settings and must be enabled once over USB.
BUSYBAR_TOKEN=your_lan_access_key_here

# BUSY Cloud API Bearer Token (from https://cloud.busy.app)
BUSYBAR_CLOUD_TOKEN=your_cloud_bearer_token_here
